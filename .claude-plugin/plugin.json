{
  "name": "scaletest",
  "displayName": "ScaleTest MCP",
  "description": "Local-first HTTP load testing and guarded Kubernetes scaling experiments through Claude Code.",
  "version": "0.1.1",
  "author": {
    "name": "Aakash Siwach"
  },
  "repository": "https://github.com/aakashsiwach/scaletest-mcp",
  "homepage": "https://github.com/aakashsiwach/scaletest-mcp",
  "keywords": [
    "devops",
    "load-testing",
    "k6",
    "kubernetes",
    "autoscaling",
    "mcp"
  ],
  "mcpServers": {
    "scaletest": {
      "command": "uv",
      "args": [
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "run",
        "--no-sync",
        "scaletest"
      ]
    }
  },
  "license": "MIT",
  "network": {
    "hosts": [
      "*"
    ]
  }
}
